{
  "name": "@patchgames/engine",
  "version": "0.28.1",
  "private": true,
  "type": "module",
  "description": "Sandboxed multiplayer game runtime, authoring helpers and browser presentation for PatchGames.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./sandbox/*": "./src/sandbox/*.ts",
    "./host/*": "./src/sandbox/host/*.ts",
    "./shared/*": "./src/shared/*.ts",
    "./client/*": "./src/client/game/*.ts",
    "./ui": "./src/client/ui/gameUi.ts",
    "./install": {
      "types": "./tools/generated/materialize-engine.d.mts",
      "default": "./tools/generated/materialize-engine.mjs"
    },
    "./starters": "./tools/starters.ts",
    "./material-lab": "./examples/material-lab.ts",
    "./foliage-lab": "./examples/foliage-lab.ts",
    "./generation-lab": "./examples/generation-lab.ts",
    "./lod-lab": "./examples/lod-lab.ts",
    "./leaf-lod-lab": "./examples/leaf-lod-lab.ts",
    "./planet-lab": "./examples/planet-lab.ts"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "third-party",
    "tools",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "starters"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check:boundary && npm run typecheck && npm test && npm run check:package",
    "demo": "node --no-liftoff --no-wasm-lazy-compilation --v8-pool-size=1 examples/headless.ts",
    "check:boundary": "node tools/check-public-boundary.mjs",
    "check:package": "node tools/check-public-boundary.mjs --pack",
    "prepack": "node tools/check-public-boundary.mjs",
    "demo:materials": "vite --host 127.0.0.1 --open /examples/material-lab.html",
    "demo:foliage": "vite --host 127.0.0.1 --open /examples/foliage-lab.html",
    "demo:generation": "vite --host 127.0.0.1 --open /examples/generation-lab.html",
    "demo:lod": "vite --host 127.0.0.1 --open /examples/lod-lab.html",
    "demo:leaf-lod": "vite --host 127.0.0.1 --open /examples/leaf-lod-lab.html",
    "demo:planet": "vite --host 127.0.0.1 --open /examples/planet-lab.html"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "@colyseus/sdk": "^0.18.4",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "@dimforge/rapier3d-compat": "0.20.0",
    "@colyseus/schema": "^5.0.34",
    "esbuild": "^0.28.2",
    "@babel/parser": "7.29.9",
    "three": "^0.186.0",
    "vite": "^8.3.0",
    "cannon-es": "0.20.0",
    "simplex-noise": "4.0.3",
    "@tweenjs/tween.js": "25.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jacadasag-dev/patchgames-engine.git"
  },
  "homepage": "https://github.com/Jacadasag-dev/patchgames-engine#readme"
}
